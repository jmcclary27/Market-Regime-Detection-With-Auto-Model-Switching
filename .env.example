# Safe deployment template for live simulation.
# Do not put credentials in this file. Provide secrets through your cloud runtime,
# VM environment, or mounted credential provider.

PROJECT_ROOT=/app
DATA_DIR=/app/data
PYTHONPATH=/app
MLFLOW_TRACKING_URI=file:/app/mlruns

# Non-secret artifact bucket name only; credentials should come from the runtime.
ARTIFACT_BUCKET=
AWS_REGION=us-east-1

# live-sim uses src/config/settings.yaml for trading-loop settings.
